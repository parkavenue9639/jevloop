# Copy this file to .env and fill in your keys:   cp env.example .env
# .env is git-ignored; never commit it.
#
# Jev decision model key: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Text helper key (OpenAI-compatible endpoint; defaults to DeepSeek chat)
DEEPSEEK_API_KEY=

# Optional overrides:
# TEXT_MODEL=deepseek-chat
# TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# TYPESAFE_MODEL=jev-latest
#
# Local Laya instead of hosted Jev. Install the matching extra first, then
# start `uv run jevloop laya-serve` and point the runtime at it:
#   Apple Silicon: cd backend && uv sync --extra laya-mlx
#   NVIDIA:        cd backend && uv sync --extra laya-cuda
# DECISION_PROVIDER=laya
# LAYA_BASE_URL=http://127.0.0.1:8791   # make dev sets this for the dashboard process
# LAYA_API_KEY=
# LAYA_MODEL=                 # empty: route english vs multilingual from the state
# LAYA_RUNTIME=auto           # auto | mlx | cuda
# LAYA_DEVICE=                # mlx: gpu|cpu   cuda: cuda|cpu
# LAYA_MODELS=english,multilingual
# LAYA_MAX_LEN=8192
# LAYA_HEAD_MAX_LEN=1024
# LAYA_PRELOAD=1
# DEEPSEEK_PRICE_IN_PER_MTOK=0.27
# DEEPSEEK_PRICE_CACHE_HIT_PER_MTOK=0.07
# DEEPSEEK_PRICE_OUT_PER_MTOK=1.10
