{
  "name": "jevloop",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"uv run --project backend jevloop serve --port 8790\" \"pnpm --filter jevloop-web dev\"",
    "build:frontend": "pnpm --filter jevloop-web build",
    "serve": "uv run --project backend jevloop serve --port 8790",
    "test": "uv run --project backend pytest backend/tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
